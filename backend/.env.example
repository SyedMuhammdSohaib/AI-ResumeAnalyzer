# Copy this file to .env and fill in your key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Model for analysis (must be available on your Groq account / region).
# Original spec: llama-3.3-70b-versatile (404 on this key -> using gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b
