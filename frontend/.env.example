# and point it at your running backend. No trailing slash.
#
# Local development:
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
#
# Production (Render): use the URL of your deployed backend service, e.g.
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
